<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro de Pizza</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body class="container">
    <form action="">
        <div class="my-2">
            <label for="" class="form-label">Nome</label>
            <input type="text" name="" id="" class="form-control" placeholder="Digite o nome da pizza">
        </div>
        <div class="my-2">
            <label for="" class="form-label">Descriçao</label>
            <input type="text" name="" id="" class="form-control" placeholder="Digite a descrição da pizza">
        </div>
        <div class="my-2">
            <label for="" class="form-label">Preço</label>
            <input type="text" name="" id="" class="form-control" placeholder="Digite preço da pizza">
        </div>
        <div class="my-2">
            <label for="" class="form-label">Imagem</label>
            <input type="file" name="" id="" class="form-control">
        </div>
        <div class="my-2">
            <a href="" class="btn btn-success">Cadastrar</a>
            <a href="" class="btn btn-danger">Cancelar</a>
        </div>
    </form>
</body>
</html>