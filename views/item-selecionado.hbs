<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tela de pedidos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body class="container">
    <div>
        <h5>Borda</h5>
        <div>
            <input type="radio" name="borda" id="id-radio-sem-borda">
            <label for="id-radio-sem-borda">Sem borda</label>
        </div>
        <div>
            <input type="radio" name="borda" id="id-radio-catupiry">
            <label for="id-radio-catupiry">Catupiry</label>
        </div>
        <div>
            <input type="radio" name="borda" id="id-radio-chedar">
            <label for="id-radio-chedar">Chedar</label>
        </div>
    </div>
    <div>
        <label for="">Observações</label>
        <div>
            <textarea class="form-control" name="" id="" rows="4" cols="150"></textarea>
        </div>
    </div>

    <div>
            <div class="row">
                <div class="col">
                    <a href="/pedido" class="btn btn-primary w-100">Voltar</a>
                </div>
                <div class="col">
                    <a href="#" class="btn btn-primary w-100">Adicionar</a>
                </div>
            </div>
        </div>
</body>
</html>