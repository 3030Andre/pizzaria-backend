<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Pedidos Encaminhados - Pizzaria</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
  <style>
    body { font-family: Arial, sans-serif; background: #f5f5f5; margin: 0; padding: 20px; }
    h2 { text-align: center; margin-bottom: 20px; }
    .pedido { background: white; padding: 20px; margin-bottom: 20px; border-radius: 8px; }
    .item { display: grid; grid-template-columns: 80px 1fr 120px 120px; align-items: center; gap: 10px; border-bottom: 1px solid #eee; padding: 10px 0; }
    .item img { width: 70px; border-radius: 8px; }
    .total-pedido { font-weight: bold; text-align: right; margin-top: 10px; }
  </style>
</head>
<body>

    <a href="/" class="btn btn-primary">Voltar</a>

  <h2>Pedidos Encaminhados 🍕</h2>

  {{#if pedidos.length}}
    {{#each pedidos}}
      <div class="pedido">
        <h3>Pedido #{{this.pedido_id}}</h3>

        {{#each this.pizzas}}
          <div class="item">
            <img src="{{this.img}}" alt="{{this.nome}}">
            <div>{{this.nome}}</div>
            <div>R$ {{this.preco}}</div>
            <div>Qtd: {{this.quantidade}}</div>
            <div>Total: R$ {{calcTotal this.preco this.quantidade}}</div>
          </div>
        {{/each}}

        <div class="total-pedido">
          Subtotal: R$ {{subtotal this.pizzas}}
        </div>
      </div>
    {{/each}}
  {{else}}
    <p>Você não possui pedidos encaminhados.</p>
  {{/if}}

</body>
</html>