<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<title>Carrinho Pizzaria</title>

<style>
body {
  font-family: Arial, sans-serif;
  background: #f5f5f5;
  margin: 0;
}

.container {
  display: flex;
  gap: 20px;
  max-width: 1100px;
  margin: 30px auto;
}

/* ESQUERDA - PRODUTOS */
.cart {
  flex: 2;
  background: white;
  padding: 20px;
  border-radius: 8px;
}

.cart h2 {
  margin-bottom: 20px;
}

.item {
  display: grid;
  grid-template-columns: 80px 1fr 120px 120px 120px;
  align-items: center;
  gap: 10px;
  border-bottom: 1px solid #eee;
  padding: 15px 0;
}

.item img {
  width: 70px;
  border-radius: 8px;
}

.qty {
  display: flex;
  align-items: center;
}

.qty button {
  width: 30px;
  height: 30px;
  border: none;
  background: #ddd;
  cursor: pointer;
}

.qty span {
  padding: 0 10px;
}

/* DIREITA - RESUMO */
.summary {
  flex: 1;
  background: white;
  padding: 20px;
  border-radius: 8px;
  height: fit-content;
}

.summary h3 {
  margin-bottom: 20px;
}

.row {
  display: flex;
  justify-content: space-between;
  margin: 10px 0;
}

.total {
  font-weight: bold;
  font-size: 18px;
}

button.main {
  width: 100%;
  padding: 15px;
  background: #c62828;
  color: white;
  border: none;
  margin-top: 20px;
  cursor: pointer;
  font-size: 16px;
}

button.main:hover {
  background: #b71c1c;
}

.cupom {
  margin-top: 20px;
}

.cupom input {
  width: 100%;
  padding: 10px;
  margin-top: 10px;
}

.cupom button {
  width: 100%;
  padding: 10px;
  margin-top: 10px;
}
</style>
</head>

<body>

<div class="container">

  <!-- PRODUTOS -->
  <div class="cart" id="cart"></div>

  <!-- RESUMO -->
  <div class="summary">
    <h3>Total no carrinho</h3>

    <div class="row">
      <span>Subtotal</span>
      <span id="subtotal">R$ 0</span>
    </div>

    <div class="row">
      <span>Entrega</span>
      <span><button onclick="calcularEntrega()">Calcular</button></span>
    </div>

    <div class="row total">
      <span>Total</span>
      <span id="total">R$ 0</span>
    </div>

    <button class="main" onclick="finalizar()">Fechar Compra</button>

    <div class="cupom">
      <p>Cupom</p>
      <input placeholder="Código do cupom">
      <button>Aplicar cupom</button>
    </div>
  </div>

</div>

<script>
const cart = [
  {
    nome: "Pizza Calabresa",
    preco: 40,
    qtd: 1,
    img: "https://cdn-icons-png.flaticon.com/512/3132/3132693.png"
  },
  {
    nome: "Pizza Frango com Catupiry",
    preco: 45,
    qtd: 2,
    img: "https://cdn-icons-png.flaticon.com/512/1404/1404945.png"
  }
];

let entrega = 0;

function render() {
  const cartDiv = document.getElementById("cart");
  cartDiv.innerHTML = "<h2>Seu Carrinho 🍕</h2>";

  let subtotal = 0;

  cart.forEach((item, i) => {
    const totalItem = item.preco * item.qtd;
    subtotal += totalItem;

    cartDiv.innerHTML += `
      <div class="item">
        <img src="${item.img}">
        <div>${item.nome}</div>
        <div>R$ ${item.preco.toFixed(2)}</div>
        
        <div class="qty">
          <button onclick="menos(${i})">-</button>
          <span>${item.qtd}</span>
          <button onclick="mais(${i})">+</button>
        </div>

        <div>R$ ${totalItem.toFixed(2)}</div>
      </div>
    `;
  });

  document.getElementById("subtotal").innerText = "R$ " + subtotal.toFixed(2);
  document.getElementById("total").innerText = "R$ " + (subtotal + entrega).toFixed(2);
}

function mais(i) {
  cart[i].qtd++;
  render();
}

function menos(i) {
  if (cart[i].qtd > 1) {
    cart[i].qtd--;
  } else {
    cart.splice(i, 1);
  }
  render();
}

function calcularEntrega() {
  entrega = 10;
  render();
  alert("Entrega calculada: R$ 10");
}

function finalizar() {
  alert("Pedido finalizado! 🍕");
}

render();
</script>

</body>
</html>