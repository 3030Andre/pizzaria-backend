<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8">
    <title>Carrinho Pizzaria</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous">
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
      crossorigin="anonymous"></script>
    <style>
body { font-family: Arial, sans-serif; background: #f5f5f5; margin: 0; }
.container { display: flex; gap: 20px; max-width: 1100px; margin: 30px auto; }
.cart { flex: 2; background: white; padding: 20px; border-radius: 8px; }
.cart h2 { margin-bottom: 20px; }
.item { display: grid; grid-template-columns: 80px 1fr 120px 120px 120px; align-items: center; gap: 10px; border-bottom: 1px solid #eee; padding: 15px 0; }
.item img { width: 70px; border-radius: 8px; }
.summary { flex: 1; background: white; padding: 20px; border-radius: 8px; height: fit-content; }
.summary h3 { margin-bottom: 20px; }
.row { display: flex; justify-content: space-between; margin: 10px 0; }
.total { font-weight: bold; font-size: 18px; }
button.main { width: 100%; padding: 15px; background: #c62828; color: white; border: none; margin-top: 20px; cursor: pointer; font-size: 16px; }
button.main:hover { background: #b71c1c; }
</style>
  </head>
  <body>

    <div class="container">

      <div class="cart">
        <h2>Seu Carrinho 🍕</h2>

        {{#if pizzas.length}}
        {{#each pizzas}}
        <div class="item">
          <img src="{{this.img}}" alt="{{this.nome}}">
          <div>{{this.nome}}</div>
          <div>R$ {{this.preco}}</div>
          <div>{{this.quantidade}}</div>
          <div>R$ {{calcTotal this.preco this.quantidade}}</div>
        </div>
        {{/each}}
        {{else}}
        <p>Seu carrinho está vazio.</p>
        {{/if}}
        <a href="/" class="btn btn-primary">Voltar</a>
      </div>

      <div class="summary">
        <h3>Total no carrinho</h3>
        <div class="row">
          <span>Subtotal</span>
          <span>R$ {{subtotal pizzas}}</span>
        </div>
        <div class="row">
          <span>Entrega</span>
          <span>R$ 10</span>
        </div>
        <div class="row total">
          <span>Total</span>
          <span>R$ {{total pizzas 10}}</span>
        </div>
        <form action="/finalizar-pedido" method="POST">
          <button type="submit" class="main">Fechar Compra</button>
        </form>
      </div>

    </div>

  </body>
</html>