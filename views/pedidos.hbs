<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Página de Pedidos</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</head>
<body class="container">
    <div class="text-center">
        <img src="/img/logo.png" alt="">
    </div>

    <a href="/" class="btn btn-primary">Voltar</a>
   <a href="/cadastro-pizza" class="btn btn-primary">Cadastrar pizza</a>

    <div class="row">
        {{#each pizzas}}
            <div class="col-6">
                <a href="/item-selecionado/{{id}}" class="text-decoration-none text-body">
                    <div class="row bg-light rounded m-2">
                        <div class="col">
                            <h3>{{nome}}</h3>
                            <p>{{descricao}}</p>
                            <p>{{preco}}</p>
                        </div>
                        <div class="col">
                            <img class="rounded w-100" src="{{img}}" alt="">
                        </div>
                    </div>
                </a>
            </div>
        {{/each}}
    </div>
</body>
</html>